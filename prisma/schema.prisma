// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Type {
  id  Int @id @default(autoincrement())
  name  String @unique //e.g. electric
  url String
  pokemons Pokemon[]

}

// catalogo condiviso: un pokemon viene salvato una sola volta,
// anche se è nel pokedex di più utenti
model Pokemon {
  id  Int @id
  name  String  @unique
  height Int // decimetri
  weight Int // ettogrammi
  types Type[]
  imageUrl String?
  owners UserPokemon[]
}

// pokemon posseduti da ogni utente (clerkId = userId di Clerk)
model UserPokemon {
  id        Int      @id @default(autoincrement())
  clerkId   String
  pokemonId Int
  pokemon   Pokemon  @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // stesso pokemon non può essere aggiunto due volte dallo stesso utente;
  // l'indice copre anche le ricerche per solo clerkId
  @@unique([clerkId, pokemonId])
}
